# ── 数据库 ──────────────────────────────────────────
# 本地开发：file:dev.db（自动创建，无需手动初始化）
# 生产环境：Turso libSQL 连接串
#     1. 创建 Turso 数据库：turso db create my-summarizer
#     2. 获取连接串：turso db show my-summarizer --url
#     3. 获取认证令牌：turso db tokens create my-summarizer
#     示例：libsql://my-summarizer-xxx.turso.io
DATABASE_URL=
# Turso 认证令牌（本地 file: 协议无需设置，生产必填）
DATABASE_AUTH_TOKEN=

# ── AI ─────────────────────────────────────────────
# 兼容 OpenAI、DeepSeek 等 OpenAI 兼容 API
OPENAI_API_KEY=
# 可选，默认 https://api.openai.com/v1
# OPENAI_BASE_URL=
# 可选，默认 gpt-4o
# OPENAI_MODEL=

# ── 应用 ────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── 开发 ────────────────────────────────────────────
# 设为 true 跳过 AI 调用，使用模拟数据
MOCK_AI=false
